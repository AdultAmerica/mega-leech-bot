# Copy this file to ".env" for local testing and fill in real values.
# NEVER commit the real .env — it is already in .gitignore.
# On the VPS, docker-compose passes this file to the container via env_file.

# From https://my.telegram.org  ->  "API development tools"
API_ID=1234567
API_HASH=your_api_hash_here

# From @BotFather  ->  /newbot  (or an existing bot's token)
BOT_TOKEN=123456789:AA_your_bot_token_here

# Your own numeric Telegram user id  (get it from @userinfobot)
# This user is the owner: full control, including managing users and restarting.
OWNER_ID=123456789

# Optional. Extra owners — same powers as OWNER_ID, comma separated.
# EXTRA_OWNERS=111111111,222222222

# Optional. Sudo users: can run jobs and change settings, but cannot manage
# users or restart. More can be added at runtime with /users add <id>.
# SUDO_USERS=333333333

# Optional. Name shown in the bot's panel headers — useful when you run two
# bots and want to tell their dashboards apart.
# BRAND=MEGA LEECH

# Your MEGA account (Pro / Pro Lite recommended)
MEGA_EMAIL=you@example.com
MEGA_PASSWORD=your_mega_password

# Where the database, MEGAcmd session and temporary downloads live.
# compose mounts a named volume at this exact path.
DATA_DIR=/data
