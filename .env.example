# Copy this file to ".env" for local testing and fill in real values.
# NEVER commit the real .env — it is already in .gitignore.
# On the VPS, copy this to ".env" next to the Dockerfile and pass it to
# `docker run` with --env-file .env.

# From https://my.telegram.org  ->  "API development tools"
API_ID=1234567
API_HASH=your_api_hash_here

# From @BotFather  ->  /newbot  (or an existing bot's token)
BOT_TOKEN=123456789:AA_your_bot_token_here

# Your own numeric Telegram user id  (get it from @userinfobot)
# Only this user can command the bot.
OWNER_ID=123456789

# Your MEGA account (Pro / Pro Lite recommended)
MEGA_EMAIL=you@example.com
MEGA_PASSWORD=your_mega_password

# Where the database and temporary downloads live.
# On the VPS, mount a host folder to this exact path with `docker run -v`.
DATA_DIR=/data
